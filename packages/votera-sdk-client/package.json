{
  "name": "votera-sdk-client",
  "version": "1.6.0",
  "author": "BOSagora Foundation",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/votera-sdk-client.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosagora/votera-sdk.git"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "TESTING=true tsdx test --verbose --runInBand",
    "test:client": "TESTING=true tsdx test test/client.test.ts --verbose --runInBand",
    "test:01-Reception": "TESTING=true tsdx test test/methods/01-Reception.test.ts --verbose --runInBand",
    "test:02-Assessment": "TESTING=true tsdx test test/methods/02-Assessment.test.ts --verbose --runInBand",
    "test:03-Vote": "TESTING=true tsdx test test/methods/03-Vote.test.ts --verbose --runInBand",
    "test:04-Transition": "TESTING=true tsdx test test/methods/04-Transition.test.ts --verbose --runInBand",
    "test:05-System-Params": "TESTING=true tsdx test test/methods/05-System-Params.test.ts --verbose --runInBand",
    "lint": "tsdx lint --fix",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "clean": "rm -Rf .turbo dist"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint --fix"
    }
  },
  "size-limit": [
    {
      "path": "dist/votera-sdk-client.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/votera-sdk-client.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^7.0.8",
    "dotenv": "^16.3.1",
    "ganache": "^7.9.2",
    "glob": "^8.0.3",
    "husky": "^7.0.4",
    "size-limit": "^7.0.8",
    "tsdx": "^0.14.1",
    "tslib": "^2.3.1",
    "typescript": "^4.6.2"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/constants": "^5.7.0",
    "@ethersproject/contracts": "^5.7.0",
    "@ethersproject/hash": "^5.7.0",
    "@ethersproject/keccak256": "^5.7.0",
    "@ethersproject/networks": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@ethersproject/random": "^5.7.0",
    "@ethersproject/wallet": "^5.7.0",
    "votera-contracts-lib": "~1.5.2",
    "votera-sdk-common": "~1.5.0",
    "unfetch": "~4.2.0"
  },
  "jest": {
    "testEnvironment": "../../test-environment.js",
    "testTimeout": 180000000
  }
}
